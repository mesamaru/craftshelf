# 公開する URL(パスキー・Cookie・メールのリンクに使う)
APP_URL=http://localhost:3000
# 32 文字以上のランダムな文字列(openssl rand -base64 32)
BETTER_AUTH_SECRET=
# PostgreSQL。手元で Docker を使わずに試すときは pglite:./.data/pg も使える
DATABASE_URL=postgres://craftshelf:craftshelf@localhost:5432/craftshelf
# 利用者の IP を入れてくるヘッダー(回数制限に使う)。Cloudflare Tunnel の後ろなら cf-connecting-ip
CLIENT_IP_HEADER=

# --- Docker(サービス版: docker-compose.service.yml)---
POSTGRES_PASSWORD=
# Cloudflare Zero Trust → Networks → Tunnels で作ったトンネルのトークン
TUNNEL_TOKEN=

# --- バックアップ ---
# 保存先: nas・r2 をカンマ区切り(家の中と外の両方に置く nas,r2 を勧める)
BACKUP_TARGETS=nas,r2
BACKUP_TIME=04:00
BACKUP_KEEP_DAYS=14
TZ=Asia/Tokyo
# 暗号化の公開鍵(age-keygen で作る。秘密鍵はサーバー機の外に保管する)
BACKUP_AGE_RECIPIENT=
# NAS を使うときは、つなぎ方に合わせて重ねる(Windows で compose を動かすときは区切りを ; にする)
# COMPOSE_FILE=docker-compose.service.yml:docker-compose.nas-smb.yml
# SMB の場合
BACKUP_NAS_SHARE=
BACKUP_NAS_USER=
BACKUP_NAS_PASSWORD=
# NFS の場合
BACKUP_NAS_HOST=
BACKUP_NAS_EXPORT=
# Cloudflare R2 の場合(R2 → API トークンで、バケットに書き込める権限のものを作る)
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=craftshelf-backup
